{
  "name": "ai-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && vite build --ssr server/index.ts --outDir dist-server",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "cloudinary": "^2.11.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.13",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.61.0",
    "matrix-js-sdk": "^44.0.0",
    "mongodb": "^7.7.0",
    "mongodb-memory-server-core": "^11.3.0",
    "motion": "^14.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "telegram": "^2.26.22",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
