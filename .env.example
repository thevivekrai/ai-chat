# Copy to .env for local development (`npm run dev:server` reads it). Never commit .env.
# In production, set these in your host's dashboard instead.

# Required ───────────────────────────────────────────────────────────────────────
# A MongoDB connection string. Without a database name in it, "tidings" is used.
MONGODB_URI=mongodb://127.0.0.1:27017/tidings
# Signs sign-in sessions. 32+ random characters, e.g. from: openssl rand -base64 48
JWT_SECRET=

# Optional ───────────────────────────────────────────────────────────────────────
# Port for the API (the Vite dev server forwards /api here).
PORT=5001

# Encrypts stored chats and linked sessions: 32 random bytes, base64 (openssl rand -base64 32).
# If unset, a key is derived from JWT_SECRET, and changing that secret makes stored chats
# unreadable. Changing either means linking WhatsApp and Telegram again.
DATA_ENCRYPTION_KEY=

# "Continue with Google": an OAuth client id (type "Web application") from
# https://console.cloud.google.com/apis/credentials, with your site's address under
# "Authorized JavaScript origins" (and http://localhost:5173 for development).
GOOGLE_CLIENT_ID=
# Syncing tasks to Google Calendar: the same client's secret, with the Calendar API enabled and
# https://<your site>/api/calendar/callback under "Authorized redirect URIs".
GOOGLE_CLIENT_SECRET=

# Linking Telegram accounts: an app's api_id and api_hash from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your own profile photo. Photos and files in chats are fetched from WhatsApp or Telegram instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Your own chat site (Guffshuff), bridged as another network: where it lives. Users link it in
# Settings with their username and password there, which the server keeps encrypted so the link
# signs itself in again when the site's weekly session runs out. GUFFSHUFF_URL=off turns it off.
GUFFSHUFF_URL=https://guffshuff.onrender.com

# The shared AI: gives everyone signed in real AI without a key of their own. The key stays on
# the server. An OpenRouter key (sk-or-…, from https://openrouter.ai/settings/keys) uses free
# models through openrouter/free; a Google Gemini key (https://aistudio.google.com/apikey) uses
# gemini-flash-latest and, for sorting, gemini-flash-lite-latest. AI_PROVIDER=openrouter|gemini
# says which when the key doesn't; AI_MODEL and AI_TRIAGE_MODEL pick other models.
AI_API=
AI_PROVIDER=
AI_MODEL=
AI_TRIAGE_MODEL=

# Hosts that put idle services to sleep (Render's free plan) would drop the WhatsApp and Telegram
# links. While any account is linked, the server visits its own address every 10 minutes to stay
# awake: on Render it knows the address by itself; elsewhere, set KEEP_AWAKE_URL. KEEP_AWAKE=off
# turns this off.
KEEP_AWAKE=
KEEP_AWAKE_URL=

# While MONGODB_URI can't be reached, the server keeps accounts in a private database of its own
# so signing in and linking work anyway; they move to MONGODB_URI once it answers (and are lost if
# the server restarts first). TEMPORARY_STORAGE=off waits for the database instead.
TEMPORARY_STORAGE=
